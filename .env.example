# Vultr Serverless Inference is OpenAI-compatible.
# Leave LLM_API_KEY empty to run the local fallback analyst (real sandbox, scripted policy).
# Challenge 1 judging expects these calls to go to Vultr when you deploy.
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_PROVIDER=auto

# docker is the containment boundary. subprocess is only for unit tests.
SANDBOX_MODE=docker
SANDBOX_IMAGE=fathom-sandbox:local
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5
QUERY_TIMEOUT_S=8
MAX_ROWS=500
SNAPSHOT_ROW_CAP=20000

# Host ports. On a Vultr VM set WEB_PORT=80 if nothing else is bound there.
WEB_PORT=43123
API_PORT=43124

# Optional HTTPS via Caddy (docker compose --profile https up -d).
# Bind web to loopback so Caddy owns 80/443:
#   WEB_PORT=127.0.0.1:43123
#   FATHOM_DOMAIN=45-77-121-63.sslip.io
FATHOM_DOMAIN=
WEB_UPSTREAM_PORT=43123
